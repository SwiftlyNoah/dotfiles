#!/bin/zsh
# Builds a launcher app in ~/Applications for each shared browser, named after its "name"
# in the local config (see home/lib/agent-browser.zsh), pinned in the Dock by
# configuration.nix. Opening one shows that browser (agent-browser-mode <name> show).
#
# Each is a few lines of shell in a bundle, with the browser's icon.png from
# ~/.config/agent-browser/<name>/ (Chrome's own icon without one), ad-hoc signed. It never
# shows in the Dock or ⌘Tab itself (LSUIElement): Chrome does, once it's in front. Home
# Manager runs this on every switch; it only rebuilds a launcher that changed.
emulate -L zsh
setopt err_exit no_unset pipe_fail
source "${0:A:h:h}/lib/agent-browser.zsh"
readonly MODE="$HOME/.dotfiles/home/bin/agent-browser-mode"

for instance in ${(f)"$(agent_browser_ids)"}; do
  agent_browser_instance $instance
  app="$HOME/Applications/$NAME.app"
  icon="$CONFIG/icon.png"
  [[ -f $icon ]] || icon="/Applications/Google Chrome.app/Contents/Resources/app.icns"
  stamp="$instance $(shasum -a 256 <"$icon" | cut -c1-16) $(shasum -a 256 <"$0" | cut -c1-16)"
  [[ -f $app/Contents/Resources/stamp && $(<"$app/Contents/Resources/stamp") == "$stamp" ]] && continue

  print -- "agent-browser-launchers: building $app"
  tmp=$(mktemp -d)
  bundle="$tmp/$NAME.app"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
  cat >"$bundle/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>local.agent-browser.$instance</string>
  <key>CFBundleName</key><string>$NAME</string>
  <key>CFBundleDisplayName</key><string>$NAME</string>
  <key>CFBundleExecutable</key><string>launcher</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
EOF
  print -r -- "#!/bin/zsh
exec ${(q)MODE} $instance show" >"$bundle/Contents/MacOS/launcher"
  chmod +x "$bundle/Contents/MacOS/launcher"

  if [[ $icon == *.icns ]]; then
    cp "$icon" "$bundle/Contents/Resources/icon.icns"
  else
    iconset="$tmp/icon.iconset"
    mkdir "$iconset"
    for size in 16 32 128 256 512; do
      sips -z $size $size "$icon" --out "$iconset/icon_${size}x${size}.png" >/dev/null
      sips -z $((size * 2)) $((size * 2)) "$icon" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns "$iconset" -o "$bundle/Contents/Resources/icon.icns"
  fi
  print -r -- "$stamp" >"$bundle/Contents/Resources/stamp"
  codesign --force --sign - "$bundle" 2>/dev/null

  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  mv "$bundle" "$app"
  rm -rf "$tmp"
  # So the Dock and Finder show the new icon rather than a cached one.
  touch "$app"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
done
