#!/bin/zsh
# Shows a shared browser to me, or puts it back out of sight (see home/lib/agent-browser.zsh).
#
#   agent-browser-mode <id> show   bring its window in front of me (its launcher app)
#   agent-browser-mode <id> hide   hide it again (Hammerspoon, once I'm done)
#
# Its Chrome keeps running either way, windowed and only hidden, so neither restarts it:
# agents carry on in their tabs while I look.
emulate -L zsh
setopt err_exit no_unset pipe_fail
source "${0:A:h:h}/lib/agent-browser.zsh"
agent_browser_instance "${1:?usage: agent-browser-mode <id> <show|hide>}"

case ${2:?usage: agent-browser-mode <id> <show|hide>} in
  show)
    # Marks it as mine to look at, so Hammerspoon doesn't hide it straight back.
    mkdir -p "$STATE"
    touch "$STATE/visible"
    # Chrome may be relaunching (an update, a crash): it is back within seconds.
    agent_browser_wait_up 30 || { print -u2 -- "agent-browser: the $1 Chrome is not running"; exit 1; }
    agent_browser_front
    ;;
  hide)
    rm -f "$STATE/visible"
    agent_browser_app hide
    ;;
  *)
    print -u2 -- "usage: agent-browser-mode <id> <show|hide>"
    exit 2
    ;;
esac
