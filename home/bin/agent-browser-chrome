#!/bin/zsh
# Keeps one shared browser's Chrome running (main by default; see home/lib/agent-browser.zsh):
# a launchd agent per browser (home.nix) runs this. Whenever its Chrome exits (a crash, a
# quit by accident, a relaunch for an update), this starts the next one as soon as the old
# one's processes are gone. It never exits itself, so a restart never waits out launchd's
# throttle on jobs that exit: it runs itself again, from the files as they are now, so a
# change to these scripts reaches the next Chrome it starts.
#
#   agent-browser-chrome [id]   (an id from the local config's browsers)
#
# A Chrome started some other way may already hold the profile; then this waits for it to
# go away instead of starting a second one on the same profile.
emulate -L zsh
setopt no_unset
source "${0:A:h:h}/lib/agent-browser.zsh"
agent_browser_instance "${1:-main}" || exit 1

# After its Chrome exits: start the next one at once when agent_browser_restart quit it on
# purpose, and otherwise wait first. A logout or shutdown quits Chrome first and stops this job
# a few seconds later; a Chrome started again at once reads to macOS as an app interrupting the
# logout ("Google Chrome interrupted log out"). So the wait ends early, with no new Chrome, when
# launchd stops the job. A crash or an accidental quit costs the wait; a Chrome that can't stay
# up isn't relaunched in a tight loop either.
after_exit() {
  if [[ -e $STATE/restart-now ]]; then
    rm -f "$STATE/restart-now"
    return
  fi
  trap 'exit 0' TERM HUP INT
  sleep 20 &
  wait $!
  trap - TERM HUP INT
}

# A Chrome already on the profile (this job was just reloaded, by a rebuild say, while its
# Chrome carried on) is waited for, and its exit treated like any other. A moment's wait is
# only the last one's helpers going away.
waited=$SECONDS
while agent_browser_running; do sleep 0.5; done
(( SECONDS - waited > 3 )) && after_exit
# No Chrome while the session ends (home/bin/agent-browser-logout marks it): launchd starts this
# job again after stopping it, and a new Chrome then would stop the logout. A logout that is
# cancelled lets the mark expire, and the next Chrome starts then. Nor while
# home/bin/agent-browser-pause holds them closed for an upgrade of Chrome itself.
trap 'exit 0' TERM HUP INT
while agent_browser_logout_pending || agent_browser_hold_pending; do
  sleep 2 &
  wait $!
done
trap - TERM HUP INT
agent_browser_prepare
agent_browser_args
started=$SECONDS
# Through Launch Services in the background (-g), as a new instance beside mine (-n), and
# waiting until it quits (-W). A rebuild that reloads this job stops only this script and
# `open`: Chrome and the agents' tabs carry on, and the next run waits for it above.
open -g -n -W -a "Google Chrome" --args "${reply[@]}"
(( SECONDS - started < 5 )) && print -u2 -- "agent-browser: the $NAME Chrome exited right away; trying again shortly"
after_exit
exec "${0:A}" "${1:-main}"
