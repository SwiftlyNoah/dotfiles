#!/bin/zsh
# Checks this Mac against the device rules a security review sets for every laptop that
# touches company data (FileVault, a screen lock within 5 minutes, automatic updates, a
# firewall), plus backups, disk space, Touch ID for sudo and commit signing.
#
# Prints one line per check, then a summary line to paste as evidence. With --notify (the
# nightly launchd job in home.nix) it also posts a notification when anything fails.
emulate -L zsh
setopt no_unset pipe_fail
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

readonly MAX_LOCK_MINUTES=5
readonly MAX_BACKUP_AGE_DAYS=3
readonly MAX_DISK_PERCENT=85

typeset -a lines failed
check() { # name, 1 for pass, detail
  if (( $2 )); then
    lines+=("PASS  $1: $3")
  else
    lines+=("FAIL  $1: $3")
    failed+=("$1")
  fi
}

# FileVault
check "FileVault" $(fdesetup status | grep -q "FileVault is On" && echo 1 || echo 0) \
  "$(fdesetup status | head -n1)"

# Firewall
fw=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>&1)
check "Firewall" $([[ $fw == *enabled* ]] && echo 1 || echo 0) "$fw"

# Screen lock: the display sleeps (or the screen saver starts) within 5 minutes on every
# power source, and the password is asked for at once.
lock_after=0
for m in $(pmset -g custom | awk '$1 == "displaysleep" { print $2 }'); do
  (( m == 0 )) && { lock_after=99999; break; }
  (( m > lock_after )) && lock_after=$m
done
saver=$(defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null || echo 0)
(( saver > 0 && saver / 60 < lock_after )) && lock_after=$(( saver / 60 ))
lock=$(sysadminctl -screenLock status 2>&1)
case $lock in
  *immediate*) password="password asked at once" ;;
  *"is off"*) password="but the screen lock is off (turn it on: sysadminctl -screenLock immediate -password -)" ;;
  *) password="password asked after ${${lock##*delay is }:-an unknown delay}" ;;
esac
lock_ok=$(( lock_after > 0 && lock_after <= MAX_LOCK_MINUTES ))
[[ $lock == *immediate* ]] || lock_ok=0
check "Screen lock" $lock_ok "display sleeps after ${lock_after} min idle, $password"

# Automatic updates
sw() { defaults read /Library/Preferences/com.apple.SoftwareUpdate "$1" 2>/dev/null || echo 0; }
updates_ok=1
for key in AutomaticCheckEnabled AutomaticDownload CriticalUpdateInstall AutomaticallyInstallMacOSUpdates; do
  [[ $(sw $key) == 1 ]] || { updates_ok=0; missing_update=$key; }
done
check "Automatic updates" $updates_ok \
  "$( (( updates_ok )) && echo "check, download, security responses and macOS installs on" || echo "$missing_update is off")"

# Time Machine
latest=$(tmutil latestbackup 2>/dev/null)
if [[ $latest =~ '([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})' ]]; then
  backup_day=${match[1]}
  age=$(( ($(date +%s) - $(date -j -f %Y-%m-%d "$backup_day" +%s)) / 86400 ))
  check "Time Machine" $(( age <= MAX_BACKUP_AGE_DAYS )) "last backup $backup_day ($age days ago)"
elif tmutil status 2>/dev/null | grep -q "FirstBackup = 1"; then
  pct=$(tmutil status | awk -F'"' '/ Percent = / { printf "%d", $2 * 100; exit }')
  check "Time Machine" 0 "first backup in progress (${pct:-0}%)"
else
  check "Time Machine" 0 "no completed backup found (is the backup disk connected?)"
fi

# Disk space
used=$(df -k /System/Volumes/Data | awk 'NR == 2 { sub("%", "", $5); print $5 }')
check "Disk space" $(( used < MAX_DISK_PERCENT )) "${used}% used"

# Touch ID for sudo
check "Touch ID for sudo" $(grep -qs pam_tid /etc/pam.d/sudo_local && echo 1 || echo 0) \
  "$(grep -qs pam_tid /etc/pam.d/sudo_local && echo on || echo off)"

# Commit signing
signing=$(cd / && git config --get commit.gpgsign 2>/dev/null)
signing_ok=0
[[ $signing == true && -f $HOME/.ssh/id_ed25519.pub ]] && signing_ok=1
check "Commit signing" $signing_ok \
  "commit.gpgsign=${signing:-unset}, key $([[ -f $HOME/.ssh/id_ed25519.pub ]] && echo present || echo missing)"

print -l -- $lines
total=${#lines}
passed=$(( total - ${#failed} ))
summary="mac-check $(date '+%Y-%m-%d %H:%M') on $(scutil --get ComputerName): $passed/$total pass"
(( ${#failed} )) && summary+=", FAIL: ${(j:, :)failed}"
print -- "\n$summary"

if [[ ${1:-} == --notify ]] && (( ${#failed} )) && command -v terminal-notifier >/dev/null; then
  terminal-notifier -title "mac-check" -group mac-check \
    -message "Failing: ${(j:, :)failed}. Run mac-check for details."
fi
(( ${#failed} == 0 ))
